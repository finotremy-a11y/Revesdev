<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
  <head>
    <title><%= content_for(:title) || "RêvesDev | Logiciels métiers, automatisation et IA sur-mesure" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="description" content="<%= content_for?(:description) ? yield(:description) : "Remy Finot, développeur Full-Stack (Ruby on Rails, C#, .NET). Logiciels métiers, automatisation et intégration d'IA sur-mesure pour entreprises et institutions." %>">
    <meta name="robots" content="index, follow">

    <%# Open Graph %>
    <meta property="og:site_name" content="RêvesDev">
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= request.original_url %>">
    <meta property="og:title" content="<%= content_for?(:title) ? yield(:title) : "RêvesDev | Logiciels métiers, automatisation et IA sur-mesure" %>">
    <meta property="og:description" content="<%= content_for?(:description) ? yield(:description) : "Remy Finot, développeur Full-Stack (Ruby on Rails, C#, .NET). Logiciels métiers, automatisation et IA sur-mesure." %>">
    <meta property="og:image" content="<%= content_for?(:og_image) ? yield(:og_image) : "#{request.base_url}/icon.png" %>">

    <%# Twitter/X Card %>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= content_for?(:title) ? yield(:title) : "RêvesDev | Logiciels métiers, automatisation et IA sur-mesure" %>">
    <meta name="twitter:description" content="<%= content_for?(:description) ? yield(:description) : "Remy Finot, développeur Full-Stack (Ruby on Rails, C#, .NET)." %>">

    <%# Canonical %>
    <link rel="canonical" href="<%= request.original_url %>">

    <%# JSON-LD Structured Data %>
    <%= render "shared/json_ld" %>

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <!-- Google Fonts & Remix Icon -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@500;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet"/>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="antialiased selection:bg-primary selection:text-white bg-background text-slate-50">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:bg-white focus:text-slate-900 focus:px-4 focus:py-2 focus:rounded-md">Aller au contenu principal</a>
    <!-- Navigation -->
    <nav class="fixed w-full z-50 glass top-0 transition-all duration-300" aria-label="Navigation principale">
        <% nav_links = [["Services", services_path], ["Secteur public", secteur_public_path], ["Portfolio", projects_path], ["À propos", about_path]] %>
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-20">
                <div class="flex-shrink-0">
                    <%= link_to root_path, class: "font-heading font-bold text-2xl tracking-tighter text-white", aria: { label: "RêvesDev, accueil" } do %>
                        Rêves<span class="text-secondary">Dev</span>.
                    <% end %>
                </div>
                <div class="hidden md:block">
                    <div class="ml-4 lg:ml-10 flex items-baseline space-x-3 lg:space-x-8">
                        <% nav_links.each do |label, path| %>
                            <%= link_to label, path, class: "#{current_page?(path) ? 'text-white' : 'text-slate-300'} hover:text-white transition-colors px-3 py-2 rounded-md font-medium", aria: { current: (current_page?(path) ? "page" : nil) } %>
                        <% end %>
                        <%= link_to "Me Contacter", new_contact_path, class: "bg-primary/20 text-indigo-400 border border-primary/30 hover:bg-primary hover:text-white transition-all duration-300 px-5 py-2 rounded-full font-medium shadow-[0_0_15px_rgba(99,102,241,0.2)] hover:shadow-[0_0_20px_rgba(99,102,241,0.5)]", aria: { current: (current_page?(new_contact_path) ? "page" : nil) } %>
                    </div>
                </div>
                <details class="md:hidden relative">
                    <summary class="list-none cursor-pointer p-2 text-white rounded-md" aria-label="Menu">
                        <i class="ri-menu-line text-2xl" aria-hidden="true"></i>
                    </summary>
                    <div class="absolute right-0 top-full mt-4 w-64 bg-slate-900 border border-white/10 rounded-2xl p-4 flex flex-col gap-1 shadow-xl">
                        <% nav_links.each do |label, path| %>
                            <%= link_to label, path, class: "#{current_page?(path) ? 'text-white' : 'text-slate-300'} hover:text-white px-3 py-3 rounded-md font-medium", aria: { current: (current_page?(path) ? "page" : nil) } %>
                        <% end %>
                        <%= link_to "Me Contacter", new_contact_path, class: "mt-2 text-center bg-primary text-white px-5 py-3 rounded-full font-medium", aria: { current: (current_page?(new_contact_path) ? "page" : nil) } %>
                    </div>
                </details>
            </div>
        </div>
    </nav>

    <%= render "shared/alerts" %>

    <%= yield %>

    <!-- Footer -->
    <footer id="contact" class="border-t border-white/5 bg-surface pt-20 pb-10 mt-20" role="contentinfo">
        <div class="max-w-4xl mx-auto px-4 text-center">
            <h2 class="font-heading text-4xl font-bold mb-6">Un projet en tête ?</h2>
            <p class="text-slate-400 mb-10">Logiciel métier, automatisation ou intégration d'IA : décrivez-moi votre besoin, je reviens vers vous avec une première analyse.</p>
            <%= link_to new_contact_path, class: "inline-flex items-center text-xl font-bold text-white bg-primary hover:bg-indigo-600 px-8 py-4 rounded-full transition-all group" do %>
                <i aria-hidden="true" class="ri-mail-send-line mr-3 text-2xl group-hover:-translate-y-1 transition-transform"></i>
                Échanger sur votre besoin
            <% end %>
            
            <div class="mt-20 pt-8 border-t border-white/10 text-sm text-slate-400">
                <div class="flex flex-col md:flex-row justify-between items-center gap-4">
                    <p>&copy; <%= Time.current.year %> RêvesDev — Remy Finot. Tous droits réservés.</p>
                    <nav class="flex flex-wrap justify-center gap-x-6 gap-y-2" aria-label="Liens légaux">
                        <%= link_to "Mentions légales", mentions_legales_path, class: "hover:text-white transition-colors" %>
                        <%= link_to "Politique de confidentialité", politique_confidentialite_path, class: "hover:text-white transition-colors" %>
                        <%= link_to "CGU", cgu_path, class: "hover:text-white transition-colors" %>
                    </nav>
                    <div class="flex space-x-6">
                        <a href="https://github.com/finotremy-a11y" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors" aria-label="GitHub (nouvelle fenêtre)"><i class="ri-github-fill text-xl" aria-hidden="true"></i></a>
                        <a href="https://www.linkedin.com/in/remy-finot-6253463a3" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors" aria-label="LinkedIn (nouvelle fenêtre)"><i class="ri-linkedin-fill text-xl" aria-hidden="true"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </footer>
  </body>
</html>
